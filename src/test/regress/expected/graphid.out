-----------------------
 12345.123
 12345.1234
 12346.123
 65535.281474976710655
(4 rows)

SELECT g.* FROM GRAPHID_TBL g WHERE g.f1 <  '12345.123'::graphid;
    f1    
----------
 0.0
 12345.1
 12345.12
(3 rows)

SELECT g.* FROM GRAPHID_TBL g WHERE g.f1 <= '12345.123'::graphid;
    f1     
-----------
 0.0
 12345.1
